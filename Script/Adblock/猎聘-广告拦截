// liepin_ad.js
let body = $response.body;

try {
  let obj = JSON.parse(body);

  const adKeys = [
    "adList",
    "bannerList",
    "ads",
    "ad",
    "adData",
    "recommendAd",
    "splashAd",
    "promotions",
    "promotion",
    "advert",
    "advertisement",
    "material",
    "materials"
  ];

  function clean(o) {
    if (!o || typeof o !== "object") return;

    for (const k of Object.keys(o)) {
      const lower = k.toLowerCase();

      if (adKeys.some(x => lower.includes(x.toLowerCase()))) {
        o[k] = Array.isArray(o[k]) ? [] : null;
      } else {
        clean(o[k]);
      }
    }
  }

  clean(obj);

  $done({ body: JSON.stringify(obj) });
} catch (e) {
  $done({});
}
