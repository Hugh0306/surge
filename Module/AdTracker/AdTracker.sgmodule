#!name=广告请求抓包记录
#!desc=自动记录疑似开屏广告/启动广告的网络请求，通过面板查看记录，辅助分析和编写拦截规则
#!category=🔍 开发工具

[Panel]
AdTracker = script-name=AdTrackerPanel, title="广告抓包记录", content="加载中…", style=info, update-interval=60

[Script]
# 记录器：捕获所有经过的 HTTP(S) 请求，匹配广告特征后记录
AdTrackerLog = type=http-request, pattern=^https?://.+, script-path=https://raw.githubusercontent.com/Hugh0306/surge/main/Module/AdTracker/AdTracker.js, requires-body=false, max-size=-1, timeout=10

# 面板：展示抓包记录摘要
AdTrackerPanel = type=generic, timeout=15, script-path=https://raw.githubusercontent.com/Hugh0306/surge/main/Module/AdTracker/AdTrackerPanel.js

# 导出报告：在 Surge 脚本列表中手动运行（本地文件，方便即时更新）
AdTrackerExport = type=cron, cronexp="0 0 1 1 *", timeout=30, script-path=AdTrackerExport.js

# 清空记录：在 Surge 脚本列表中手动运行（本地文件）
AdTrackerClear = type=cron, cronexp="0 0 1 1 *", timeout=10, script-path=AdTrackerClear.js

[MITM]
hostname = %APPEND% *
