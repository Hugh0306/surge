author: 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
homepage: https://hub.kelee.one
icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DiDi.png
dns: {}
rules:
- domain:
    match: gwp.xiaojukeji.com
    policy: REJECT
- and:
    match:
    - asn:
        match: '45090'
        no_resolve: true
    - dest_port:
        match: '25641'
    - protocol:
        match: TCP
    policy: REJECT
- and:
    match:
    - asn:
        match: '55990'
        no_resolve: true
    - dest_port:
        match: '25641'
    - protocol:
        match: TCP
    policy: REJECT
- and:
    match:
    - asn:
        match: '63646'
        no_resolve: true
    - dest_port:
        match: '25641'
    - protocol:
        match: TCP
    policy: REJECT
url_rewrites:
- match: ^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/lion\.didialift\.com\/broker\/\?
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v1\/other\/slow\?
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/ct\.xiaojukeji\.com\/agent\/v3\/feeds\?
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/conf\.diditaxi\.com\.cn\/dynamic\/conf
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/poi\.map\.xiaojukeji\.com\/mapapi\/recommend\?
  location: http://reject-dict/
  status_code: 200
body_rewrites:
- response_jq:
    match: ^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v1\/core\?
    filter: .data.disorder_cards.bottom_nav_list.data |= map(select(.id == "home_page" or .id == "user_center")) | .data.order_cards.nav_list_card.data |= map(select(.nav_id == "dache_anycar" or .nav_id == "carmate" or .nav_id == "driverservice" or .nav_id == "zhandianbashi" or .nav_id == "yuancheng" or .nav_id == "pincheche" or .nav_id == "bike" or .nav_id == "special_ride" or .nav_id == "nav_more_v3"))
- response_jq:
    match: ^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v1\/other\/fast\?
    filter: delpaths([["data","disorder_cards","communicate_card"],["data","disorder_cards","not_login_bottom_bar"],["data","disorder_cards","riding_code_card"],["data","order_cards","car_owner_widget_card"],["data","order_cards","marketing_card"],["data","order_cards","super_banner_card"],["data","disorder_cards","car_icon","data","icon_info_new_agreement"]])
- response_jq:
    match: ^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget\?
    filter: delpaths([["data","mult_home_banner"]])
- response_jq:
    match: ^https:\/\/common\.diditaxi\.com\.cn\/common\/v5\/usercenter\/layout$
    filter: .data |= (.instances |= (to_entries | map(select(.key as $k | ["center_base_info_card", "center_tool_card", "center_wallet_finance_card", "center_order_related_card"] | index($k))) | from_entries)) | .data.instances.center_wallet_finance_card.data.view_info |= map(select(.title == "优惠卡券" or .title == "余额" or .title == "福利金"))
- response_jq:
    match: ^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v1\/dache_homepage_layout\?
    filter: .data |= (.instances |= (to_entries | map(select(.key | test("feed_back_|dache_main_member|order_container_|dache_main_core_icon|dache_main_card_"))) | from_entries))
- response_jq:
    match: ^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v1\/pSFCHomePage\?
    filter: .data |= (if . == null then null else {hot_route_info, legal_info} end) | . as $root | .data.tab_list = ($root.data.tab_list | map(select(.tab_id == "passenger")))
- response_jq:
    match: ^https:\/\/daijia\.kuaidadi\.com:443\/gateway\?
    filter: delpaths([["data","variantInfo"]])
- response_jq:
    match: ^https:\/\/daijia\.kuaidadi\.com:443\/gateway\?
    filter: .data |= with_entries(select(.value.isAd != 1))
- response_jq:
    match: ^https:\/\/api\.udache\.com\/intercity\/ticket\/api\/v1\/core\/getFullPageInfoLayout\?
    filter: .data.disorder_components |= (map(select(.name == "history_order_card" or .name == "inprogress_order_card" or .name == "station_calendar" or .name == "main_card_v2" or .name == "user_history_order")))
- response_jq:
    match: ^https:\/\/htwkop\.xiaojukeji\.com:443\/gateway\?
    filter: delpaths([["data","didi-bike-homepage-popup"],["data","variantInfo"]])
- response_jq:
    match: ^https:\/\/as\.xiaojukeji\.com\/ep\/as\/toggles\?
    filter: .data |= map(if .name|IN("daijia_journey_new_tcp_switch","daijia_tcp_init","daijia_tcp_msg_encrypt","daijia_tcp_site_info","daijia_tcp_site_report")then.allow=false else. end)
