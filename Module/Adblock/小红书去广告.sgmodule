#!name=小红书去广告
#!desc=过滤信息流推广，移除图片及视频水印
#!author=RuCu6[https://github.com/RuCu6], fmz200[https://github.com/fmz200]
#!homepage=https://github.com/Hugh0306/surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/RedPaper.png
#!category=BetaModule
#!openUrl=https://apps.apple.com/app/id741292507
#!tag=去广告
#!date=2026-05-20 00:00:00

[Rule]
# Unsupported Egern AND rule, kept inactive to avoid overblocking: {"match"=>[{"protocol"=>{"match"=>"QUIC"}}, {"domain_suffix"=>{"match"=>"xiaohongshu.com"}}], "policy"=>"REJECT"}

[URL Rewrite]
^https:\/\/ci\.xiaohongshu\.com\/system_config\/watermark - reject-img
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action) - reject-dict
^https:\/\/www\.xiaohongshu\.com\/api\/marketing\/box\/trigger\? - reject-dict
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v2\/guide\/user_banner|v3\/note\/guide) - reject-dict
^https:\/\/www\.xiaohongshu\.com\/api\/sns\/(?:v1\/ads\/resource|v2\/hey\/\w+\/hey_gallery) - reject-dict

[Body Rewrite]
http-response-jq ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/banner_list$ '.data = {}'
http-response-jq ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/hot_list$ '.data.items = []'
http-response-jq ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/hint '.data.hint_words = []'
http-response-jq ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/trending\? '.data.queries = [] | .data.hint_word = {}'

[Script]
移除图片和实况照片水印 = type=http-response, pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/(?:imagefeed|live_photo\/save), requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js
移除界面整体配置 = type=http-response, pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system\/service\/ui\/config\?, requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js
移除开屏广告 = type=http-response, pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system_service\/config\?, requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js
移除开屏广告 = type=http-response, pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/system_service\/splash_config, requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js
移除详情页小部件、关注页感兴趣的人 = type=http-response, pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/(?:note\/widgets|user\/followings\/followfeed), requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js
移除信息流广告 = type=http-response, pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/followfeed\?, requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js
移除详情页感兴趣的人 = type=http-response, pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v5\/recommend\/user\/follow_recommend\?, requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js
移除评论区实况照片水印 = type=http-response, pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v1\/interaction\/comment\/video\/download|v5\/note\/comment\/list), requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js
移除图片和视频水印 = type=http-response, pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v2\/note\/feed|v3\/note\/videofeed), requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js
移除信息流广告 = type=http-response, pattern=^https:\/\/(?:edith|rec)\.xiaohongshu\.com\/api\/sns\/v6\/homefeed\?, requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js
移除搜索页广告 = type=http-response, pattern=^https:\/\/(?:edith|so)\.xiaohongshu\.com\/api\/sns\/v10\/search\/notes\?, requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js
移除视频水印 = type=http-response, pattern=^https:\/\/(?:edith|rec|www)\.xiaohongshu\.com\/api\/sns\/(?:v4\/note\/videofeed|v10\/note\/video\/save), requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js

[MITM]
hostname = %APPEND% ci.xiaohongshu.com, edith.xiaohongshu.com, rec.xiaohongshu.com, so.xiaohongshu.com, www.xiaohongshu.com
