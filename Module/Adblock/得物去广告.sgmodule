name: 得物去广告
description: 移除开屏广告、弹窗。
open_url: https://apps.apple.com/app/id1012871328
author: 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
homepage: https://hub.kelee.one
icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Dewu.png
dns: {}
url_rewrites:
- match: ^https:\/\/app\.dewu\.com\/api\/v1\/app\/advertisement\/
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/app\.dewu\.com\/hacking-newbie\/v1\/app\/coupon\/module\?
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/app\.dewu\.com\/api\/v1\/app\/search\/lexicon\/v3\/background_words\?
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/app\.dewu\.com\/api\/v1\/app\/search\/lexicon\/v3\/background_words\?
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/app\.dewu\.com\/api\/v1\/app\/search\/lexicon\/v1\/rank_words\?
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/app\.dewu\.com\/sns-rec\/v1\/attention\/feed\?
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/app\.dewu\.com\/sns-rec\/v1\/search\/word-skip\/new-list\?
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/app\.dewu\.com\/sns-rec\/v1\/search\/hotword-list\?
  location: http://reject-dict/
  status_code: 200
body_rewrites:
- response_jq:
    match: ^https:\/\/app\.dewu\.com\/api\/v1\/app\/biz-aggregate\/me\/user-index\?
    filter: .data.modules |= map(if .key == "wallet" then .data.menus |= map(select(.key == "coupon" or .key == "allowance" or .key == "gift" or .key == "balance")) else . end) | .data.modules |= map(select(.key != "merchant" and .key != "discountCoupon"))
- response_jq:
    match: ^https:\/\/app\.dewu\.com\/api\/v1\/app\/account\/wallet\/page\/entrance\?
    filter: '.data.groupInfoDTOS |= map(.moduleInfoDTO = {assetModule: .moduleInfoDTO.assetModule}) | .data.moduleNames = [.data.moduleNames[] | select(. == "assetModule")] | . as $full | $full | .data.groupNames |= (map(select(. == "MAIN" or . == "ASYNC_COMMON" or . == "ASYNC_GOODS_FEEDS")))'
- response_jq:
    match: ^https:\/\/app\.dewu\.com\/identify-discovery\/v1\/discovery\/index\?
    filter: .data.groups |= map(.items |= map(select(.title == "消息中心")))
mitm:
  hostnames:
    includes:
    - app.dewu.com