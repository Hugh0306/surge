#!name=高德地图去广告
#!desc=过滤高德地图开屏广告、各页面推广。
#!author=RuCu6[https://github.com/RuCu6], kelv1n1n[https://github.com/kelv1n1n], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://github.com/Hugh0306/surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Amap.png
#!category=BetaModule
#!openUrl=https://apps.apple.com/app/id461703208
#!tag=去广告
#!date=2026-05-20 00:00:00

[Rule]
DOMAIN,amap-aos-info-nogw.amap.com,REJECT
DOMAIN,free-aos-cdn-image.amap.com,REJECT
DOMAIN-SUFFIX,v.smtcdns.com,REJECT

[URL Rewrite]
^https:\/\/m5\.amap\.com\/ws\/shield\/search\/new_hotword\? - reject-dict
^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/card-service-(?:car-end|route-plan) - reject-dict
^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/tips_adv\? - reject-dict
^https:\/\/oss\.amap\.com\/ws\/banner\/lists\/\? - reject-dict
^https:\/\/ai\.amap\.com\/v1\/ai_rec\/ - reject-dict
^https:\/\/m5\.amap\.com\/ws\/aos\/main\/page\/product\/list\? - reject-dict
^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/(?:main-page-assets|main-page-location|ridewalk-end-fc|usr-profile-fc\/homeV2) - reject-dict
^https:\/\/m5\.amap\.com\/ws\/(?:mapapi\/hint_text\/offline_data|message\/notice\/list|shield\/search\/new_hotword) - reject-dict
^https:\/\/m5\.amap\.com\/ws\/shield\/scene\/recommend\? - reject-dict
^https:\/\/m5\.amap\.com\/ws\/valueadded\/weather\/v2\? - reject-dict
^https:\/\/sns\.amap\.com\/ws\/msgbox\/pull_mp\? - reject-dict
^https:\/\/m5-zb\.amap\.com\/ws\/boss\/(?:order\/car\/(?:feedback\/get_card_questions|feedback\/viptips|king_toolbox_car_bubble|remark\/satisfactionConf|rights_information)|tips\/onscene_visual_optimization) - reject-dict
^https:\/\/m5-zb\.amap\.com\/ws\/boss\/(?:pay\/web\/paySuccess\/info\/request|transportation\/diversion\/resource\/driving) - reject-dict

[Body Rewrite]
http-response-jq ^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured\? 'delpaths([["data","commonMaterial"],["data","tipsOperationLocation"],["data","resourcePlacement"]])'
http-response-jq ^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/homepage\? 'delpaths([["history_tags"]])'
http-response-jq ^https:\/\/m5-zb\.amap\.com\/ws\/sharedtrip\/taxi\/order_detail_car_tips\? 'delpaths([["data","carTips","data","popupInfo"]])'

[Script]
移除路线规划推广 = type=http-response, pattern=^https:\/\/m5\.amap\.com\/ws\/aos\/perception\/publicTravel\/beforeNavi\?, requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/Amap/Amap_remove_ads.js
移除路线规划、导航结束页推广 = type=http-response, pattern=^https:\/\/m5\.amap\.com\/ws\/bus\/plan\/integrate\?, requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/Amap/Amap_remove_ads.js
移除导航详情页底部酒店、处理附近页 = type=http-response, pattern=^https:\/\/m5\.amap\.com\/ws\/c3frontend\/(?:af-(?:hotel|launch)\/page\/main|af-nearby\/nearby), requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/Amap/Amap_remove_ads.js
移除路线规划推广 = type=http-response, pattern=^https:\/\/m5\.amap\.com\/ws\/perception\/drive\/(?:routeInfo|routePlan), requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/Amap/Amap_remove_ads.js
移除搜索栏推广 = type=http-response, pattern=^https:\/\/m5\.amap\.com\/ws\/shield\/search_bff\/hotword\?, requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/Amap/Amap_remove_ads.js
移除搜索详情页推广 = type=http-response, pattern=^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/(?:mps|search\/sp|sug|tips_operation_location), requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/Amap/Amap_remove_ads.js
移除首页推广 = type=http-response, pattern=^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/(?:card-service-plan-home|main-page), requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/Amap/Amap_remove_ads.js
移除首页推广 = type=http-response, pattern=^https:\/\/m5\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1\?, requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/Amap/Amap_remove_ads.js
移除我的页面推广 = type=http-response, pattern=^https:\/\/m5\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaasv3\?, requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/Amap/Amap_remove_ads.js
移除附近页推广 = type=http-response, pattern=^https:\/\/m5\.amap\.com\/ws\/shield\/search\/nearbyrec_smart\?, requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/Amap/Amap_remove_ads.js
移除开屏广告 = type=http-response, pattern=^https:\/\/m5\.amap\.com\/ws\/valueadded\/alimama\/splash_screen\?, requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/Amap/Amap_remove_ads.js
移除打车页推广卡片、弹窗 = type=http-response, pattern=^https:\/\/m5-zb\.amap\.com\/ws\/boss\/(?:car\/order\/content_info|order_web\/friendly_information), requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/Amap/Amap_remove_ads.js
移除打车页红点角标、天气图标 = type=http-response, pattern=^https:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource(\/home)?\?, requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/Amap/Amap_remove_ads.js
移除导航详情页推广 = type=http-response, pattern=^https:\/\/(?:info|m5)\.amap\.com\/ws\/shield\/search\/(?:common\/coupon\/info|poi\/detail), requires-body=1, max-size=-1, timeout=60, script-path=https://kelee.one/Resource/JavaScript/Amap/Amap_remove_ads.js

[MITM]
hostname = %APPEND% *.amap.com
