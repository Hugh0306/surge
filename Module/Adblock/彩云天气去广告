name: 彩云天气去广告
description: 移除首页推广、弹窗、悬浮窗。
open_url: https://apps.apple.com/app/id847764912
author: RuCu6[https://github.com/RuCu6]
homepage: https://hub.kelee.one
icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ColorfulClouds.png
dns: {}
rules:
- domain:
    match: abyss.cyapi.cn
    policy: REJECT
- domain:
    match: ad.cyapi.cn
    policy: REJECT
- domain:
    match: gather.colorfulclouds.net
    policy: REJECT
url_rewrites:
- match: ^https:\/\/biz\.cyapi\.cn\/(p\/v1\/entries|p\/v1\/trial_card\/info|v2\/product)
  location: http://reject-dict/
  status_code: 200
- match: ^https:\/\/starplucker\.cyapi\.cn\/v3\/(config\/cypage\/\w+\/conditions|notification\/message_center|operation\/homefeatures)
  location: http://reject-dict/
  status_code: 200
scriptings:
- http_response:
    name: 彩云天气去广告
    match: ^https:\/\/(wrapper\.cyapi\.cn|api\.caiyunapp\.com|cdn-w\.caiyunapp\.com)\/v1\/activity\?
    script_url: https://kelee.one/Resource/JavaScript/ColorfulClouds/ColorfulClouds_remove_ads.js
    body_required: true
mitm:
  hostnames:
    includes:
    - biz.cyapi.cn
    - starplucker.cyapi.cn
    - api.caiyunapp.com
    - cdn-w.caiyunapp.com
