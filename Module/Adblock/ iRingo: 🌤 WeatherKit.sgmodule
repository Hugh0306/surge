[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP
DOMAIN,tether.edge.apple,REJECT-DROP
# Unsupported Egern AND rule, kept inactive to avoid overblocking: {"match"=>[{"or"=>{"match"=>[{"asn"=>{"match"=>"714", "no_resolve"=>true}}, {"asn"=>{"match"=>"6185", "no_resolve"=>true}}]}}, {"protocol"=>{"match"=>"QUIC"}}], "policy"=>"REJECT-DROP"}

[Script]
🌤 WeatherKit.api.v1.availability.response = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/, requires-body=1, max-size=-1, timeout=60, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v3.1.0/response.bundle.js
🌤 WeatherKit.api.v2.weather.response = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/, requires-body=1, max-size=-1, timeout=60, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v3.1.0/response.bundle.js

[MITM]
hostname = %APPEND% weatherkit.apple.com
