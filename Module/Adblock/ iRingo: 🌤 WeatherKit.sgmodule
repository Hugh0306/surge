name: ' iRingo: 🌤 WeatherKit'
description: |-
  iOS 18 & macOS 15 & watchOS 11
compat_arguments:
  Weather.Provider: ColorfulClouds
  NextHour.Provider: ColorfulClouds
  AirQuality.Calculate.Algorithm: EU_EAQI
  API.ColorfulClouds.Token: ''
  API.QWeather.Host: devapi.qweather.com
  API.QWeather.Token: ''
  API.WAQI.Token: ''
  Storage: Argument
  LogLevel: WARN
compat_arguments_desc: |
  Weather.Provider: [天气] 数据源
      ├ WeatherKit: WeatherKit（不替换）
      ├ ColorfulClouds: 彩云天气
      └ QWeather: 和风天气
  使用选定的数据源替换天气数据。

  NextHour.Provider: [未来一小时降水强度] 数据源
      ├ WeatherKit: WeatherKit（不添加）
      ├ ColorfulClouds: 彩云天气
      └ QWeather: 和风天气
  使用选定的数据源填充未来一小时降水强度的数据。

  AirQuality.Calculate.Algorithm: [iRingo内置算法] 算法
      ├ None: 不转换
      ├ UBA: 德国LQI（FB001846）
      ├ EU_EAQI: 欧盟EAQI（ETC HE Report 2024/17）
      ├ WAQI_InstantCast_US: 美标InstantCast（EPA-454/B-24-002）
      ├ WAQI_InstantCast_CN: 国标InstantCast（HJ 633—2012）
      └ WAQI_InstantCast_CN_25_DRAFT: 国标InstantCast（HJ 633 2025年草案）
  使用内置算法，通过污染物数据本地计算空气指数。InstantCast源自于WAQI，美标版本使用了WAQI的臭氧标准。

  API.ColorfulClouds.Token: [API] 彩云天气令牌
  彩云天气 API 令牌

  API.QWeather.Host: [API] 和风天气主机
  和风天气 API 使用的主机名

  API.QWeather.Token: [API] 和风天气令牌
  和风天气 API 令牌

  API.WAQI.Token: [API] WAQI 令牌
  WAQI API 令牌，填写此字段将自动使用WAQI高级API

  Storage: [储存] 配置类型
      ├ Argument: 优先使用插件选项与模块参数等，由 $argument 传入的配置，$argument 不包含的设置项由 PersistentStore (BoxJs) 提供
      ├ PersistentStore: 只使用来自 BoxJs 等，由 $persistentStore 提供的配置
      └ database: 只使用由作者的 database.mjs 文件提供的默认配置，其他任何自定义配置不再起作用
  选择要使用的配置类型。未设置此选项或不通过此选项的旧版本的配置顺序依旧是 $persistentStore (BoxJs) > $argument > database。

  LogLevel: [调试] 日志等级
      ├ OFF: 关闭
      ├ ERROR: ❌ 错误
      ├ WARN: ⚠️ 警告
      ├ INFO: ℹ️ 信息
      ├ DEBUG: 🅱️ 调试
      └ ALL: 全部
  选择脚本日志的输出等级，低于所选等级的日志将全部输出。
open_url: http://boxjs.com/#/app/iRingo.WeatherKit
author: VirgilClyne[https://github.com/VirgilClyne],WordlessEcho[https://github.com/WordlessEcho],001[https://github.com/001ProMax]
homepage: https://NSRingo.github.io/guide/Weather/weather-kit
icon: https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
dns: {}
rules:
- domain:
    match: weather-analytics-events.apple.com
    policy: REJECT-DROP
- domain_suffix:
    match: tthr.apple.com
    policy: REJECT-DROP
- domain:
    match: tether.edge.apple
    policy: REJECT-DROP
- and:
    match:
    - or:
        match:
        - asn:
            match: '714'
            no_resolve: true
        - asn:
            match: '6185'
            no_resolve: true
    - protocol:
        match: QUIC
    policy: REJECT-DROP
scriptings:
- http_response:
    name: 🌤 WeatherKit.api.v1.availability.response
    match: ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/
    script_url: https://github.com/NSRingo/WeatherKit/releases/download/v3.1.0/response.bundle.js
    env:
      _compat.$argument: Weather.Provider="ColorfulClouds"&NextHour.Provider="ColorfulClouds"&AirQuality.Calculate.Algorithm="EU_EAQI"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&API.WAQI.Token=""&Storage="Argument"&LogLevel="WARN"
    body_required: true
- http_response:
    name: 🌤 WeatherKit.api.v2.weather.response
    match: ^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/
    script_url: https://github.com/NSRingo/WeatherKit/releases/download/v3.1.0/response.bundle.js
    env:
      _compat.$argument: Weather.Provider="ColorfulClouds"&NextHour.Provider="ColorfulClouds"&AirQuality.Calculate.Algorithm="EU_EAQI"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&API.WAQI.Token=""&Storage="Argument"&LogLevel="WARN"
    body_required: true
    binary_body: true
mitm:
  hostnames:
    includes:
    - weatherkit.apple.com
