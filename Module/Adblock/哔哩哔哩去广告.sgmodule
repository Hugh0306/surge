#!name = Bilibili 去广告
#!desc = 去除开屏广告、信息流广告、视频前贴片广告
#!tag=去广告
#!icon=https://github.com/BiliUniverse/Enhanced/raw/main/src/assets/icon_rounded.png


# 使用前提：
# 1. Surge 开启「重写」功能
# 2. Surge 开启「MitM」，并确保以下域名已在 MitM hostname 列表中：
#    app.bilibili.com, api.bilibili.com
# ==============================

[URL Rewrite]

# 开屏广告（启动时拉取的广告列表和展示上报）
^https?://app\.bilibili\.com/x/v2/splash/(list|show) reject-200

# 首页信息流广告
^https?://app\.bilibili\.com/x/v2/feed/index reject-200

# 搜索结果内广告
^https?://app\.bilibili\.com/x/v2/search reject-200

# 推荐页广告（番剧/活动 banner）
^https?://api\.bilibili\.com/x/web-interface/index/top/feed/rcmd reject-200

# 视频播放前贴片广告
^https?://api\.bilibili\.com/x/web-show/page/region reject-200

# 直播间广告
^https?://api\.live\.bilibili\.com/xlive/app-room/v1/index/getInfoByRoom reject-200

# 广告上报（静默丢弃，避免 App 报错）
^https?://data\.bilibili\.com/log/ reject-200
^https?://app\.bilibili\.com/x/report/ reject-200

[MITM]
hostname = %APPEND% app.bilibili.com, api.bilibili.com, api.live.bilibili.com, data.bilibili.com
