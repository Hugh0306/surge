#!name=哔哩哔哩去广告-稳定修复版
#!desc=过滤哔哩哔哩开屏、推荐流和动态流广告；修复搜索卡、视频简介/评论不显示
#!author=Hugh0306 / Fixed by QQ
#!category=BetaModule
#!openUrl=https://apps.apple.com/cn/app/id736536022
#!tag=去广告
#!homepage=https://github.com/Hugh0306/surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Bilibili.png
#!date=2026-05-08 00:00:00

[Rule]
DOMAIN,cm.bilibili.com,REJECT
DOMAIN-WILDCARD,*pcdn*.biliapi.net,REJECT

[URL Rewrite]
^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/show - reject
^https?:\/\/app\.bilibili\.com\/x\/v3\/splash\/ - reject
^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/splash - reject
^https?:\/\/i\d\.hdslb\.com\/bfs\/fawkes - reject
^https?:\/\/i\d\.hdslb\.com\/bfs\/manga-static\/\w+\.(jpg|png)$ - reject

[Script]
# 开屏 + 推荐流去广告
# 修复点：去掉 search?，避免搜索页卡顿
bilibili.helper.v2=type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/(splash|feed\/index),requires-body=1,max-size=-1,binary-body-mode=0,script-path=https://raw.githubusercontent.com/Hugh0306/surge/main/Script/Adblock/Bilibili/bilibili.helper.v2.js

# 弹幕相关，保留
bilibili.helper.dmView=type=http-response,pattern=^https:\/\/grpc\.biliapi\.net\/bilibili\.community\.service\.dm\.v1\.DM\/DmView,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Hugh0306/surge/main/Script/Adblock/Bilibili/bilibili.helper.js

# 青少年模式弹窗，保留
bilibili.helper.teenager=type=http-response,pattern=^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus,requires-body=1,binary-body-mode=1,max-size=-1,script-path=https://raw.githubusercontent.com/Hugh0306/surge/main/Script/Adblock/Bilibili/bilibili.helper.js

# 动态流广告，保留
bilibili.helper.dynAll=type=http-response,pattern=^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.dynamic\.v2\.Dynamic\/DynAll$,requires-body=1,binary-body-mode=1,max-size=-1,script-path=https://raw.githubusercontent.com/Hugh0306/surge/main/Script/Adblock/Bilibili/bilibili.helper.js

# 以下三条先禁用，避免破坏搜索、视频简介、评论
# bilibili.helper.v1.view=type=http-response,pattern=^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(view|viewunite)\.v1\.View\/(View|ViewProgress)$,requires-body=1,binary-body-mode=1,max-size=-1,script-path=https://raw.githubusercontent.com/Hugh0306/surge/main/Script/Adblock/Bilibili/bilibili.helper.js
# bilibili.helper.mainList=type=http-response,pattern=^https:\/\/grpc\.biliapi\.net\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList,requires-body=1,binary-body-mode=1,max-size=-1,script-path=https://raw.githubusercontent.com/Hugh0306/surge/main/Script/Adblock/Bilibili/bilibili.helper.js
# bilibili.helper.searchAll=type=http-response,pattern=^https:\/\/grpc\.biliapi\.net\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$,requires-body=1,binary-body-mode=1,max-size=-1,script-path=https://raw.githubusercontent.com/Hugh0306/surge/main/Script/Adblock/Bilibili/bilibili.helper.js

[MITM]
hostname = %APPEND% app.bilibili.com, grpc.biliapi.net
