#!name=去广告模块(增强版)
#!desc=增强版去广告
#!category=🛡️ 去广告

[General]

[Rule]
DOMAIN,ad.12306.cn,DIRECT
DOMAIN,adstrategy.biz.weibo.com,REJECT
DOMAIN,sdkapp.uve.weibo.com,DIRECT
DOMAIN-SUFFIX,optimus-ads.amap.com,DIRECT
# 哔哩哔哩广告域名（集成 Maasea/sgmodule 规则）
DOMAIN,cm.bilibili.com,REJECT
DOMAIN-WILDCARD,*pcdn*.biliapi.net,REJECT
# 美柚广告域名 - 只拦截已知广告域名，避免误杀图片资源
DOMAIN,ad.seeyouyima.com,REJECT
DOMAIN,ab.seeyouyima.com,REJECT
DOMAIN,ad-logs.seeyouyima.com,REJECT
DOMAIN,x.seeyouyima.com,REJECT
