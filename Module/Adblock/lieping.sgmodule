#!name = 猎聘去广告
#!desc = 屏蔽猎聘 App 广告、启动页广告及数据跟踪
#!system = iOS, macOS
#!version = 1.1
#!author = Hugh0306
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/8d/7f/b3/8d7fb385-9656-da2b-dfc5-63c63e79cbe0/AppIcon-0-0-1x_U007emarketing-0-8-0-0-85-220.png/400x400.png

[Script]
# 启动页广告
猎聘-启动广告 = type=http-response,pattern=^https?://api\.liepin\.com/(splash|startup|launch|guide)(/|$),requires-body=1,max-size=131072,timeout=10,script-path=https://raw.githubusercontent.com/Hugh0306/surge/refs/heads/main/Script/Adblock/%E7%8C%8E%E8%81%98-%E5%90%AF%E5%8A%A8%E5%B9%BF%E5%91%8A

# 广告接口拦截
猎聘-广告拦截 = type=http-response,pattern=^https?://(api|m-api|app)\.liepin\.com/(ad|ads|banner|recommend-ad|promotion|track|buried|log|analytics|event)(/|$),requires-body=1,max-size=131072,timeout=10,script-path=https://raw.githubusercontent.com/Hugh0306/surge/refs/heads/main/Script/Adblock/%E7%8C%8E%E8%81%98-%E5%B9%BF%E5%91%8A%E6%8B%A6%E6%88%AA

[Rule]
# 跟踪 & 埋点
DOMAIN-SUFFIX,analytics.liepin.com,REJECT
DOMAIN-SUFFIX,track.liepin.com,REJECT
DOMAIN-SUFFIX,log.liepin.com,REJECT
DOMAIN-SUFFIX,beacon.liepin.com,REJECT
DOMAIN-SUFFIX,buried.liepin.com,REJECT
DOMAIN-SUFFIX,event.liepin.com,REJECT
DOMAIN-KEYWORD,liepin-ad,REJECT
DOMAIN-KEYWORD,liepin-track,REJECT
# 广告 SDK
DOMAIN-SUFFIX,growingio.com,REJECT
DOMAIN-SUFFIX,giocdn.com,REJECT
DOMAIN-SUFFIX,umengcloud.com,REJECT
DOMAIN-SUFFIX,umsns.com,REJECT
DOMAIN-SUFFIX,app.adjust.com,REJECT
DOMAIN-SUFFIX,appsflyer.com,REJECT
DOMAIN-SUFFIX,mintegral.com,REJECT
DOMAIN-SUFFIX,talkingdata.net,REJECT
DOMAIN-SUFFIX,talkingdata.com,REJECT
URL-REGEX,^https?://.*liepin\.com.*(ad|banner|splash|recommend[-_]ad|promotion|advert),REJECT

[MITM]
hostname = %APPEND% api.liepin.com, m-api.liepin.com, app.liepin.com
