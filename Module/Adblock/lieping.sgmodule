#!name = 猎聘去广告
#!desc = 屏蔽猎聘 App 广告、启动页广告及数据跟踪
#!system = iOS, macOS
#!version = 1.2
#!author = Hugh0306
#!category = BetaModule
#!tag = 去广告
#!openUrl = https://apps.apple.com/cn/app/%E7%8C%8E%E8%81%98-%E6%8B%9B%E8%81%98%E6%89%BE%E5%B7%A5%E4%BD%9C%E6%B1%82%E8%81%8C%E8%BD%AF%E4%BB%B6/id588924764
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/8d/7f/b3/8d7fb385-9656-da2b-dfc5-63c63e79cbe0/AppIcon-0-0-1x_U007emarketing-0-8-0-0-85-220.png/400x400.png
#!date = 2026-05-09 00:00:00

[Script]
# 猎聘启动页 / 开屏广告
猎聘-启动广告 = type=http-response,pattern=^https?:\/\/(api|m-api|app)\.liepin\.com\/.*(splash|startup|launch|guide|advert|ad),requires-body=1,max-size=262144,timeout=10,script-path=https://raw.githubusercontent.com/Hugh0306/surge/refs/heads/main/Script/Adblock/%E7%8C%8E%E8%81%98-%E5%90%AF%E5%8A%A8%E5%B9%BF%E5%91%8A

# 猎聘广告接口 / 推荐广告 / 埋点接口
猎聘-广告拦截 = type=http-response,pattern=^https?:\/\/(api|m-api|app)\.liepin\.com\/.*(ad|ads|banner|splash|startup|launch|promotion|track|buried|log|analytics|event|advert|material),requires-body=1,max-size=262144,timeout=10,script-path=https://raw.githubusercontent.com/Hugh0306/surge/refs/heads/main/Script/Adblock/%E7%8C%8E%E8%81%98-%E5%B9%BF%E5%91%8A%E6%8B%A6%E6%88%AA

[URL Rewrite]
# 直接拒绝明显开屏 / 广告 / 埋点请求
^https?:\/\/(api|m-api|app)\.liepin\.com\/.*(splash|startup|launch|guide|advert|ads|banner|promotion) - reject
^https?:\/\/.*\.liepin\.com\/.*(splash|startup|launch|guide|advert|ads|banner|promotion) - reject

[Rule]
# 猎聘广告 / 跟踪 / 埋点
DOMAIN-SUFFIX,analytics.liepin.com,REJECT
DOMAIN-SUFFIX,track.liepin.com,REJECT
DOMAIN-SUFFIX,log.liepin.com,REJECT
DOMAIN-SUFFIX,beacon.liepin.com,REJECT
DOMAIN-SUFFIX,buried.liepin.com,REJECT
DOMAIN-SUFFIX,event.liepin.com,REJECT

DOMAIN-KEYWORD,liepin-ad,REJECT
DOMAIN-KEYWORD,liepin-track,REJECT
DOMAIN-KEYWORD,liepin-ads,REJECT
DOMAIN-KEYWORD,liepin-advert,REJECT

# 常见广告 / 统计 SDK
DOMAIN-SUFFIX,growingio.com,REJECT
DOMAIN-SUFFIX,giocdn.com,REJECT
DOMAIN-SUFFIX,umengcloud.com,REJECT
DOMAIN-SUFFIX,umsns.com,REJECT
DOMAIN-SUFFIX,app.adjust.com,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT
DOMAIN-SUFFIX,appsflyer.com,REJECT
DOMAIN-SUFFIX,mintegral.com,REJECT
DOMAIN-SUFFIX,talkingdata.net,REJECT
DOMAIN-SUFFIX,talkingdata.com,REJECT

# 兜底匹配猎聘广告 URL
URL-REGEX,^https?:\/\/.*liepin\.com.*(ad|ads|banner|splash|startup|launch|guide|recommend[-_]?ad|promotion|advert|material),REJECT

[MITM]
hostname = %APPEND% *.liepin.com
