name: 京东去广告
description: 移除京东开屏广告，精简我的页面。
open_url: https://apps.apple.com/app/id414245413
author: RuCu6[https://github.com/RuCu6], Maasea[https://github.com/Maasea]
homepage: https://hub.kelee.one
icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png
dns: {}
rules:
- url_regex:
    match: ^http://\w{32}\.jddebug\.com/diagnose\?
    policy: REJECT
url_rewrites:
- match: ^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06])
  location: http://reject-dict/
  status_code: 200
- match: ^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=start$
  location: http://reject-array/
  status_code: 200
- match: ^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=queryMaterialAdverts
  location: http://reject-dict/
  status_code: 200
- match: ^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2436_jfs
  location: http://reject-img/
  status_code: 200
- match: ^https?:\/\/ms\.jr\.jd\.com\/gw\/generic\/aladdin\/na\/m\/getLoadingPicture
  location: http://reject-dict/
  status_code: 200
- match: ^https?:\/\/ms\.jr\.jd\.com\/gw\/generic\/base\/(new)?na\/m\/adInfo
  location: http://reject-dict/
  status_code: 200
- match: ^https?:\/\/(bdsp-x|dsp-x)\.jd\.com\/adx\/
  location: http://reject-dict/
  status_code: 200
- match: ^https?:\/\/jdread-api\.jd\.com\/jdread\/api\/channel\/module\/opens
  location: http://reject-dict/
  status_code: 200
- match: ^https?:\/\/jdread-api\.jd\.com\/jdread\/api\/popup
  location: http://reject-dict/
  status_code: 200
map_locals:
- match: ^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06])
  status_code: 200
  body: '{}'
  headers:
    Content-Type: application/json
- match: ^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=start$
  status_code: 200
  body: '[]'
  headers:
    Content-Type: application/json
- match: ^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=queryMaterialAdverts
  status_code: 200
  body: '{}'
  headers:
    Content-Type: application/json
- match: ^https?:\/\/ms\.jr\.jd\.com\/gw\/generic\/aladdin\/na\/m\/getLoadingPicture
  status_code: 200
  body: '{}'
  headers:
    Content-Type: application/json
- match: ^https?:\/\/ms\.jr\.jd\.com\/gw\/generic\/base\/(new)?na\/m\/adInfo
  status_code: 200
  body: '{}'
  headers:
    Content-Type: application/json
- match: ^https?:\/\/(bdsp-x|dsp-x)\.jd\.com\/adx\/
  status_code: 200
  body: '{}'
  headers:
    Content-Type: application/json
- match: ^https?:\/\/jdread-api\.jd\.com\/jdread\/api\/channel\/module\/opens
  status_code: 200
  body: '{}'
  headers:
    Content-Type: application/json
- match: ^https?:\/\/jdread-api\.jd\.com\/jdread\/api\/popup
  status_code: 200
  body: '{}'
  headers:
    Content-Type: application/json
body_rewrites:
- response_jq:
    match: ^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=basicConfig
    filter: .data.JDMessage.socketmonitor.isSocketEstablishedAhead = 0 | .data.JDMessage.socketmonitor.isSocketReport = 0 | .data.JDHttpToolKit.httpdns.httpdns = 0
scriptings:
- http_response:
    name: 移除京东广告
    match: ^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome)
    script_url: https://raw.githubusercontent.com/Hugh0306/surge/main/Script/Adblock/JD/JD_remove_ads_bunizao.js
    body_required: true
- http_response:
    name: 关闭京东基础配置广告开关
    match: ^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=basicConfig
    script_url: https://raw.githubusercontent.com/Hugh0306/surge/main/Script/Adblock/DDGKSF/jd_json.js
    body_required: true
- http_response:
    name: 移除京东物流开屏广告
    match: ^https:\/\/api\.m\.jd\.com\/api\?functionId=delivery_show
    script_url: https://raw.githubusercontent.com/Hugh0306/surge/main/Script/Adblock/DDGKSF/startup.js
    body_required: true
mitm:
  hostnames:
    includes:
    - api.m.jd.com
    - ms.jr.jd.com
    - bdsp-x.jd.com
    - dsp-x.jd.com
    - jdread-api.jd.com
