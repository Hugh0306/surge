[Script]
插件模块跳转 = type=http-response, pattern=^https:\/\/((pluginhub|hub)\.kelee\.one|surge\.qingr\.moe)\/, requires-body=1, max-size=-1, timeout=10, script-path=https://raw.githubusercontent.com/Hugh0306/surge/main/Script/Tool/plugin-module-to-surge.js

[MITM]
hostname = %APPEND% pluginhub.kelee.one, hub.kelee.one, surge.qingr.moe
