#!name=面板-IP纯净度检测
#!desc=展示节点 IP / 运营商 / 所在地 / ASN / IPPure 纯净度
#!category=🌠 面板模块

[Panel]
IPPure = script-name=IPPure, title="IP 纯净度", content="请刷新面板", style=info, update-interval=1

[Script]
IPPure = type=generic, timeout=10, script-path=https://raw.githubusercontent.com/Hugh0306/surge/main/Module/Panel/IPPure/IPPure.js
