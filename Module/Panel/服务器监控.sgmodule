#!name=服务器监控
#!desc=服务器监控小组件
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/09/29/e7/0929e70c-69a0-fa7d-b999-c12d7fc83883/AppIcon-0-0-1x_U007epad-0-1-sRGB-85-220.png/512x512bb.jpg

name: 服务器监控
description: 服务器监控小组件
author: Hugh0306
icon: https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/09/29/e7/0929e70c-69a0-fa7d-b999-c12d7fc83883/AppIcon-0-0-1x_U007epad-0-1-sRGB-85-220.png/512x512bb.jpg
homepage: https://github.com/Hugh0306/surge

env_schema:
  host:
    name: 主机地址
    description: SSH 服务器地址
    default_value: ""
  port:
    name: 端口
    description: SSH 端口号
    default_value: "22"
  username:
    name: 用户名
    description: SSH 登录用户名
    default_value: "root"
  password:
    name: 密码
    description: "SSH 密码（与私钥二选一）"
    default_value: ""
  privateKey:
    name: 私钥
    description: "SSH 私钥（与密码二选一）"
    default_value: ""

scriptings:
  - generic:
      name: 服务器监控
      script_url: https://raw.githubusercontent.com/egerndaddy/quick-start/main/modules/server-monitor.js

widgets:
  - name: 服务器监控
    script_name: 服务器监控
