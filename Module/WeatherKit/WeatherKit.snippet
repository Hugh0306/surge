#!name =  iRingo: 🌤 WeatherKit
#!desc = iOS 18 & macOS 15 & watchOS 11\n1.解锁全部天气功能\n2.替换空气质量数据\n3.添加下一小时降水数据\n4.添加天气数据
#!openUrl = http://boxjs.com/#/app/iRingo.WeatherKit
#!author = VirgilClyne[https://github.com/VirgilClyne],WordlessEcho[https://github.com/WordlessEcho],001[https://github.com/001ProMax]
#!homepage = https://NSRingo.github.io/guide/Weather/weather-kit
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!category =  iRingo
#!date = 2026-08-01 15:46:49
#!version = 3.2.0-beta4

#[filter_local]
host, weather-analytics-events.apple.com, reject
host-suffix, tthr.apple.com, reject
host, tether.edge.apple, reject

#[rewrite_local]
# 🌤 WeatherKit.api.v1.availability.response
^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/ url script-response-body https://raw.githubusercontent.com/Hugh0306/surge/main/Module/WeatherKit/v3.2.0-beta4/response.bundle.js
# 🌤 WeatherKit.api.v1.weatherAlerts.response
^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&party=qweather$ url script-response-body https://raw.githubusercontent.com/Hugh0306/surge/main/Module/WeatherKit/v3.2.0-beta4/response.bundle.js
# 🌤 WeatherKit.api.v2.weather.response
^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/ url script-response-body https://raw.githubusercontent.com/Hugh0306/surge/main/Module/WeatherKit/v3.2.0-beta4/response.bundle.js
# 🌤 WeatherKit.alertDetails.index.response
^https?:\/\/www\.qweather\.com\/{1,2}severe-weather\/([^/?#]+)\.html\?from=AppleWeatherService$ url 302 https://weatherkit.apple.com/alertDetails/index.html?ids=$1&lang=zh-CN&party=qweather
^https?:\/\/www\.qweather\.com\/en\/severe-weather\/([^/?#]+)\.html\?from=AppleWeatherService$ url 302 https://weatherkit.apple.com/alertDetails/index.html?ids=$1&lang=en-US&party=qweather

#[mitm]
hostname = weatherkit.apple.com, www.qweather.com
