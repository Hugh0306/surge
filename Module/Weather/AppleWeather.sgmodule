#!name=Apple 天气增强
#!desc=解锁 Apple Weather 完整功能，优化天气数据显示。
#!category=🌤 功能增强
#!author=VirgilClyne, WordlessEcho, 001
#!homepage=https://github.com/VirgilClyne/iRingo
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Weather.png

[General]
# 强制使用 HTTP 引擎处理天气请求
force-http-engine-hosts = %APPEND% weather-data.apple.com, api.weather.com

[Rule]
# Apple Weather 相关域名直连
DOMAIN,weather-analytics-events.apple.com,DIRECT
DOMAIN,weather-data.apple.com,DIRECT
DOMAIN-SUFFIX,weather.com,DIRECT
DOMAIN-SUFFIX,weatherkit.apple.com,DIRECT

[URL Rewrite]
# 优化天气 API 请求
^https?:\/\/weather-data\.apple\.com\/v1\/ https://weather-data.apple.com/v2/ 302

[Script]
# 天气数据增强脚本（基于 iRingo 项目）
# 使用 CDN 加速访问（推荐）
weather-request = type=http-request, pattern=^https?:\/\/weather-data\.apple\.com\/v\d\/weather\/, script-path=https://cdn.jsdelivr.net/gh/VirgilClyne/iRingo@main/js/Weather.request.js, timeout=10, requires-body=false
weather-response = type=http-response, pattern=^https?:\/\/weather-data\.apple\.com\/v\d\/weather\/, script-path=https://cdn.jsdelivr.net/gh/VirgilClyne/iRingo@main/js/Weather.response.js, timeout=30, requires-body=true

# 备用脚本源（GitHub Raw）：
# weather-request = type=http-request, pattern=^https?:\/\/weather-data\.apple\.com\/v\d\/weather\/, script-path=https://raw.githubusercontent.com/VirgilClyne/iRingo/main/js/Weather.request.js, timeout=10, requires-body=false
# weather-response = type=http-response, pattern=^https?:\/\/weather-data\.apple\.com\/v\d\/weather\/, script-path=https://raw.githubusercontent.com/VirgilClyne/iRingo/main/js/Weather.response.js, timeout=30, requires-body=true

[MITM]
hostname = %APPEND% weather-data.apple.com, weather-analytics-events.apple.com

# ========================================
# 脚本 URL 列表：
# ========================================
# CDN 加速（推荐）：
# - https://cdn.jsdelivr.net/gh/VirgilClyne/iRingo@main/js/Weather.request.js
# - https://cdn.jsdelivr.net/gh/VirgilClyne/iRingo@main/js/Weather.response.js
#
# GitHub Raw（备用）：
# - https://raw.githubusercontent.com/VirgilClyne/iRingo/main/js/Weather.request.js
# - https://raw.githubusercontent.com/VirgilClyne/iRingo/main/js/Weather.response.js
#
# 使用说明：
# 1. 如果脚本 URL 失效，请访问 https://github.com/VirgilClyne/iRingo 获取最新链接
# 2. 推荐使用 jsDelivr CDN 加速访问
# 3. 如 CDN 不可用，可切换到 GitHub Raw 链接
# ========================================
